BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# ── REST API ─────────────────────────────────────────────────
API_SECRET=your_super_secret_api_key_here
OUTPUT_DIR=generated

# ── Payments ─────────────────────────────────────────────────
# CryptoBot: https://t.me/CryptoBot → создать приложение
CRYPTOBOT_API_TOKEN=

# Platega (опционально)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
WEBHOOK_URL=
# ── Таймауты генерации (опционально) ─────────────────────────
# IMAGE_TIMEOUT=600          # картинка / редактирование / оживление, сек
# VIDEO_TIMEOUT=1800         # видео, сек
# TEXT_TIMEOUT=300           # текст, сек
# ARENA_VIDEO_VARIANTS=2     # сколько вариантов видео ждать
# ARENA_SUBMIT_CHECK_SECONDS=10
# ARENA_IMAGE_POLL_SECONDS=4
# ARENA_VIDEO_POLL_SECONDS=8
# ARENA_DOWNLOAD_WAIT_SECONDS=25
# ARENA_DOWNLOAD_CLICK_SECONDS=20
# ARENA_CONSENT_CHECK_SECONDS=15

# Браузер: 1 — headless (по умолчанию), 0 — с окном (нужен X-сервер, напр. xvfb-run).
# Проверка Cloudflare/reCAPTCHA чаще проходит не в headless.
ARENA_HEADLESS=1

# Сколько ждать старта генерации видео (Stop / индикатор / карточка), прежде чем сообщить «не стартовала»
# ARENA_VIDEO_START_SECONDS=120
